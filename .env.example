BOT_TOKEN=your_bot_token
BOT_USERNAME=Shootingferi_bot
ADMIN_IDS=123456789,987654321
ADMIN_PASSWORD=your_admin_password

CHANNEL_1=@feris_shop
CHANNEL_2=@Hamburger_Weryt_plugins

# Получатели звёзд (через запятую). Юзер сам выбирает, кому отправить звёзды.
STARS_RECIPIENTS=@Clulk,@No7777oN

# Кто принимает оплату реальными звёздами (по ТЗ — второй владелец).
STAR_OWNER=@No7777oN

# Процент рефералки (за купленный номер приглашённого)
REF_PERCENT=10

DB_URL=sqlite+aiosqlite:///bot.db

# ─────────────────────────────────────────────────────────────────────────────
# Автовыдача реальных номеров (сервисы приёма SMS)
# ─────────────────────────────────────────────────────────────────────────────
# Провайдер: sms-activate | 5sim | test (фейковый, без денег) | пусто = выключено.
SMS_PROVIDER=
# Ключ выбранного провайдера (из личного кабинета сервиса):
SMS_ACTIVATE_KEY=
FIVESIM_KEY=
# Автозакупка номера сразу после оплаты: 1 — да, 0 — нет.
SMS_AUTO_ISSUE=1
# Код сервиса у провайдера: tg = Telegram.
SMS_SERVICE=tg
# Наценка на закупочную цену номера (1.3 = +30%).
SMS_PRICE_MARKUP=1.3
# Как часто опрашивать сервис ради SMS (сек) и сколько ждать кода (мин).
SMS_POLL_SECONDS=20
SMS_WAIT_MINUTES=20
# Мапа «страна из витрины -> код страны у провайдера».
SMS_COUNTRY_MAP=Россия=0;Казахстан=4;Украина=1;Беларусь=3
# Страна по умолчанию, если её нет в мапе.
SMS_COUNTRY_DEFAULT=0